<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<template t-name="ksef_qr_code" >
		<t t-set="ksef_qr_url" t-value="o._build_ksef_qr_invoice_url()"/>
		<t t-if="ksef_qr_url">
			<t t-set="ksef_qr_img_b64" t-value="o._get_ksef_qr_image_base64()"/>
			<t t-if="ksef_qr_img_b64">
				<div class="mt-4 pt-3" style="border-top: 1px solid #ddd; page-break-inside: avoid;">
					<p style="font-weight: 600; font-size: 14px; margin-bottom: 8px;">
						Sprawdź, czy Twoja faktura znajduje się w KSeF
					</p>
					<div style="display: flex; align-items: flex-start; gap: 20px;">
						<div style="flex: 0 0 140px;">
							<img t-att-src="'data:image/png;base64,' + ksef_qr_img_b64"
								 style="width: 140px; height: 140px;"
								 alt="QR KSeF"/>
						</div>
						<div style="font-size: 11px; color: #555; line-height: 1.4;">
							<p style="margin-bottom: 6px;">
								Zeskanuj kod QR, aby zweryfikować fakturę
								w Krajowym Systemie e-Faktur (KSeF).
							</p>
							<p style="margin-bottom: 6px;">
								Jeżeli nie możesz zeskanować kodu, użyj linku:
							</p>
							<p style="margin-bottom: 6px;">
								<a t-att-href="ksef_qr_url"
								   style="color: #1a73e8; text-decoration: none;"
								   target="_blank">
									<t t-esc="ksef_qr_url"/>
								</a>
							</p>
							<p t-if="o.ksef_issue_mode != 'offline'" style="font-size: 10px; color: #777; margin-bottom: 0;">
								Numer KSeF:
								<span t-esc="o.ksef_number or '-'"/>
							</p>
							<p t-if="o.ksef_issue_mode != 'online'" style="font-size: 10px; color: #777; margin-bottom: 0;">
								FAKTURA WYSTAWIONA W TRYBIE OFFLINE KSeF
							</p>

						</div>
					</div>
				</div>
			</t>
		</t>
	</template>

	<template t-name="ksef_external_layout_wave">
		<!-- HEADER -->

		<!-- BODY -->
        <div t-attf-class="o_company_#{company.id}_layout article o_report_layout_striped {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}" t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <t t-out="0"/>
        </div>

	</template>

	<template t-name="ksef_document_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

		<t t-out="0"/>

	</template>


<template id="DEBUG_report_ksef_invoice">
    <t t-call="web.html_container">
		<t t-set="o" t-value="env['account.move'].browse(context.get('move_id'))"/>
		<t t-call="web.external_layout">
		   <style>
				.page {
					font-family: 'Lato', sans-serif;
				}
			</style>

			<t t-set="move" t-value="context.get('move_id', {})"/>
			<t t-set="ksef" t-value="context.get('ksef_preview_data', {})"/>
			<t t-set="lang" t-value="'pl_PL'"/>

            <!-- DEBUG - sprawdzenie co trafia do szablonu -->
            <div class="page">
                <div class="alert alert-info" style="background-color: #f0f0f0; padding: 10px; margin: 10px; border: 1px solid #ccc;">
                    <strong>DEBUG:</strong><br/>

                    0. o: <t t-esc="o or 'brak'"/><br/>
                    1. docs: <t t-esc="docs or 'brak'"/><br/>
                    1.1 doc: <t t-esc="doc or 'brak'"/><br/>
                    2. move: <t t-esc="move or 'brak'"/><br/>
                    3. data: <t t-esc="data or 'brak'"/><br/>
                    4. context: <t t-esc="context"/><br/>
                    5. ksef from context: <t t-esc="context.get('ksef_preview_data', {}).get('type', 'BRAK')"/><br/>
                    6. czy ksef ma lines: <t t-esc="len(context.get('ksef_preview_data', {}).get('lines', []))"/><br/>
                </div>
            </div>
		</t>
    </t>
</template>

	<template id="report_ksef_invoice">
		<t t-set="o" t-value="env['account.move'].browse(context.get('move_id'))"/>
		<t t-call="web.html_container">
			<t t-call="web.external_layout">
				<style>
					.page {
						font-family: 'Lato', sans-serif;
					}
				</style>

				<t t-set="move" t-value="o"/>				
				<t t-set="ksef" t-value="context.get('ksef_preview_data', {})"/>
				<t t-set="lang" t-value="'pl_PL'"/>

				<div class="page">
					<!-- Header -->
					<div class="headers">
						<h2>Faktura <b>KS</b><b class="text-danger">e</b><b>F</b></h2>
						<h5><b style="text-align: right;"><t t-esc="move.name"/></b></h5>
					</div>
					<div class="headers">
						<p style="text-align: right;">
							<strong>Numer KSeF:</strong> 
							<b style="text-align: right;"><t t-esc="move.ksef_number"/></b>
						</p>
						<p style="text-align: right;">
							<t t-set="invoice_type_map" t-value="{
								'VAT': 'Faktura VAT',
								'ZAL': 'Faktura zaliczkowa',
								'ROZ': 'Faktura Rozliczeniowa',
								'KOR': 'Korekta faktury',
								'KOR_ZAL': 'Korekta faktury zaliczkowej',
							 }"/>
							<t t-set="invoice_type_display" t-value="invoice_type_map.get(ksef.get('type', 'Nieznany'), ksef.get('type', 'Nieznany'))"/>
							<strong>Typ faktury:</strong> <t t-esc="invoice_type_display"/>
							<strong>Numer Faktury:</strong>
							<b style="text-align: right;"><t t-esc="move.name"/></b>
						</p>
					</div>
					<br/>
					<hr/>

					<!-- Original invoice for corrections -->
					<t t-if="ksef.get('original_invoice', {}).get('number')">
						<div class="alert alert-info">
							<strong>Faktura korygowana:</strong><br/>
							Numer: <t t-esc="ksef.get('original_invoice', {}).get('number')"/><br/>
							Data: <t t-esc="ksef.get('original_invoice', {}).get('date')"/><br/>
							KSeF ID: <t t-esc="ksef.get('original_invoice', {}).get('ksef_id')"/>
						</div>
					</t>

					<!-- Parties -->
					<div class="row">
						<div class="col-6">
							<h4>Wystawca</h4>
							<address>
								<strong><t t-esc="ksef.get('issuer', {}).get('name', 'Brak')"/></strong><br/>
								<t t-if="ksef.get('issuer', {}).get('nip')">
									NIP: <t t-esc="ksef.get('issuer', {}).get('nip')"/><br/>
								</t>
								<t t-if="ksef.get('issuer', {}).get('country_code') and not ksef.get('issuer', {}).get('nip')">
									Kod kraju: <t t-esc="ksef.get('issuer', {}).get('country_code')"/><br/>
									<t t-if="ksef.get('issuer', {}).get('foreign_tax_id')">
										Nr ID: <t t-esc="ksef.get('issuer', {}).get('foreign_tax_id')"/><br/>
									</t>
								</t>
								<t t-if="ksef.get('issuer', {}).get('address', {}).get('line1')">
									<t t-esc="ksef.get('issuer', {}).get('address', {}).get('line1')"/><br/>
									<t t-if="ksef.get('issuer', {}).get('address', {}).get('line2')">
										<t t-esc="ksef.get('issuer', {}).get('address', {}).get('line2')"/><br/>
									</t>
								</t>
							</address>
						</div>
						<div class="col-6">
							<h4>Nabywca</h4>
							<address>
								<strong><t t-esc="ksef.get('recipient', {}).get('name', 'Brak')"/></strong><br/>
								<t t-if="ksef.get('recipient', {}).get('nip')">
									NIP: <t t-esc="ksef.get('recipient', {}).get('nip')"/><br/>
								</t>
								<t t-elif="ksef.get('recipient', {}).get('no_tax_id')">
									Brak identyfikatora podatkowego<br/>
								</t>
								<t t-if="ksef.get('recipient', {}).get('customer_number')">
									Nr klienta: <t t-esc="ksef.get('recipient', {}).get('customer_number')"/><br/>
								</t>
								<t t-if="ksef.get('recipient', {}).get('address', {}).get('line1')">
									<t t-esc="ksef.get('recipient', {}).get('address', {}).get('line1')"/><br/>
								</t>
								<t t-if="ksef.get('recipient', {}).get('is_jst')">
									<span class="badge badge-info">Dotyczy JST</span>
								</t>
								<t t-if="ksef.get('recipient', {}).get('is_gv')">
									<span class="badge badge-info">Członek grupy VAT</span>
								</t>
							</address>
						</div>
					</div>
					<!-- End Parties -->
					<hr/>
					<!-- Invoice header data -->
					<div class="row mt-4">
						<div class="col-3">
							<strong>Data wystawienia:</strong><br/>
							<t t-esc="ksef.get('invoice', {}).get('issue_date', 'Brak')"/>
						</div>
						<div class="col-3">
							<strong>Data sprzedaży:</strong><br/>
							<t t-esc="ksef.get('invoice', {}).get('sale_date', 'Brak')"/>
						</div>
						<div class="col-3">
							<strong>Waluta:</strong><br/>
							<t t-esc="ksef.get('invoice', {}).get('currency', 'PLN')"/>
						</div>
					</div>

					<!-- Annotations (VAT procedures) - tylko dla odpowiednich typów -->
					<t t-if="ksef.get('type') in ['VAT', 'ROZ', 'ZAL'] and any(ksef.get('annotations', {}).values())">
						<div class="mt-3">
							<h5>Adnotacje / Procedury VAT</h5>
							<ul>
								<t t-if="ksef.get('annotations', {}).get('reverse_charge') and ksef.get('type') == 'ROZ'">
									<li>Odwrotne obciążenie</li>
								</t>
								<t t-if="ksef.get('annotations', {}).get('split_payment')">
									<li>Podzielona płatność (split payment)</li>
								</t>
								<t t-if="ksef.get('annotations', {}).get('exempt')">
									<li>Zwolniony z VAT</li>
								</t>
								<t t-if="ksef.get('annotations', {}).get('margin')">
									<li>Procedura marży</li>
								</t>
								<t t-if="ksef.get('annotations', {}).get('new_transport')">
									<li>Nowe środki transportu</li>
								</t>
							</ul>
						</div>
					</t>

					<hr/>
					<!-- Lines table -->
					<div class="mt-4">
						<h4>Pozycje faktury</h4>
						<table class="table table-bordered">
							<thead>
								<tr>
									<th class="text-center" style="width: 5%;">Lp.</th>
									<th style="width: 50%;">Nazwa towaru lub usługi</th>
									<th class="text-right" style="width: 12%;">Cena jedn. netto</th>
									<th class="text-center" style="width: 8%;">Ilość</th>
									<th class="text-center" style="width: 8%;">Miara</th>
									<th class="text-center" style="width: 17%;">Stawka podatku</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="idx" t-value="0"/>
								<t t-foreach="ksef.get('lines', [])" t-as="line">
									<t t-set="idx" t-value="idx + 1"/>
									
									<t t-if="line.get('is_before_correction')">
										<tr class="text-muted">
											<td colspan="6" class="text-center">
												<em>--- Stan przed korektą ---</em>
											</td>
										</tr>
									</t>
									
									<tr>
										<td class="text-center"><t t-esc="idx"/></td>
										<td><t t-esc="line.get('name', '')"/></td>
										<td class="text-right"><t t-esc="line.get('price', '0')"/></td>
										<td class="text-center"><t t-esc="line.get('qty', '0')"/></td>
										<td class="text-center"><t t-esc="line.get('unit', '')"/></td>
										<td class="text-center"><t t-esc="line.get('vat_rate', '0')"/></td>
									</tr>
								</t>
								
								<t t-if="not ksef.get('lines')">
									<tr>
										<td colspan="6" class="text-center">Brak pozycji</td>
									</tr>
								</t>
							</tbody>
						</table>
					</div>

					<!-- VAT rates summary -->
					<t t-if="ksef.get('totals', {}).get('vat_breakdown')">
						<div class="mt-4">
							<h5>Podsumowanie stawek podatku</h5>
							<table class="table table-bordered">
								<thead>
									<tr>
										<th class="text-center">Stawka VAT</th>
										<th class="text-right">Kwota netto</th>
										<th class="text-right">Kwota podatku</th>
										<th class="text-right">Kwota brutto</th>
									</tr>
								</thead>
								<tbody>
									<t t-foreach="ksef.get('totals', {}).get('vat_breakdown', [])" t-as="vat_item">
										<tr>
											<td class="text-center">
												<t t-esc="vat_item.get('rate', '0')"/>%
											</td>
											<td class="text-right">
												<t t-esc="vat_item.get('net', '0')"/>
											</td>
											<td class="text-right">
												<t t-esc="vat_item.get('vat', '0')"/>
											</td>
											<td class="text-right">
												<t t-esc="vat_item.get('gross', '0')"/>
											</td>
										</tr>
									</t>
								</tbody>
								<tfoot>
									<tr class="table-active">
										<td class="text-right"><strong>RAZEM:</strong></td>
										<td class="text-right">
											<strong><t t-esc="ksef.get('totals', {}).get('net', '0')"/></strong>
										</td>
										<td class="text-right">
											<strong><t t-esc="ksef.get('totals', {}).get('vat', '0')"/></strong>
										</td>
										<td class="text-right">
											<strong><t t-esc="ksef.get('totals', {}).get('gross', '0')"/></strong>
										</td>
									</tr>
								</tfoot>
							</table>
						</div>
					</t>

					<hr/>
					<div name="comment" style="display: none;"/>
					<t t-call="hfb_xmlmap_exporter.ksef_qr_code"/>

					<!-- Footer -->
					<div class="footer mt-5">
						<hr/>
						<p class="text-muted small">
							Źródło: KSeF XML (FA3); Hadron for Business; Odoo 2026 <br/>
						</p>
					</div>
				</div>
			</t>
		</t>
	</template>


	<!-- Definicja wydruku -->
	<record id="paperformat_ksef" model="report.paperformat">
		<field name="name">KSeF PDF</field>
		<field name="default" eval="False"/>
		<field name="format">A4</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">10</field>
		<field name="margin_bottom">10</field>
		<field name="margin_left">10</field>
		<field name="margin_right">10</field>
		<field name="dpi">120</field>
	</record>

	<!-- Definicja raportu  -->
	<record id="action_report_ksef_invoice" model="ir.actions.report">
		<field name="name">Faktura KSeF (debug)</field>
		<field name="model">account.move</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">hfb_xmlmap_exporter.report_ksef_invoice</field>
		<field name="report_file">hfb_xmlmap_exporter.report_ksef_invoice</field>
		<field name="print_report_name">'KSeF-%s' % (object.ksef_number)</field>
		<field name="paperformat_id" ref="hfb_xmlmap_exporter.paperformat_ksef"/>
	</record>


	<!-- Dodanie przycisku do widoku formularza do wydruku faktury AP KSeF -->
	<record id="view_move_form_ksef_preview" model="ir.ui.view">
		<field name="name">account.move.form.ksef.preview</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[@name='button_box']" position="inside">
				<field name="move_type" invisible="1"/>
				<button name="action_preview_ksef_pdf" 
						string="Faktura KSeF"
						type="object" 
						class="btn-secondary" 
						icon="fa-file-pdf-o"
						groups="account.group_account_invoice"
						attrs="{'invisible': ['|', ('ksef_number', '=', False), ('move_type', 'in', ['out_invoice', 'out_refund'] )]}"
						/>
			</xpath>
		</field>
	</record>


</odoo>
