<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_02" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_02" name="Import faktur z KSeF">
    <bpmn:participant id="Part_KSeF" name="API KSeF 2.0 (MF)">
    </bpmn:participant>
    <bpmn:participant id="Part_Odoo" name="Odoo 15 – hfb_xmlmap_exporter" processRef="Process_Import">
    </bpmn:participant>
    <bpmn:messageFlow id="M_List" name="Zapytanie o metadane" sourceRef="T_List" targetRef="Part_KSeF" />
    <bpmn:messageFlow id="M_Xml" name="XML faktury" sourceRef="Part_KSeF" targetRef="T_Imp" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Import" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Import">
      <bpmn:lane id="Lane_Plan" name="ir.cron 42 – planowanie listy">
        <bpmn:flowNodeRef>S_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Should</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Should</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Skip</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_List" name="ir.cron 41 – log listy">
        <bpmn:flowNodeRef>S_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_LFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_List</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Child" name="ir.cron 41 – log potomny">
        <bpmn:flowNodeRef>S_Ch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Imp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Ch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Plan" name="Co 1 h">
      <bpmn:outgoing>Flow_S_Plan_T_Should</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_S_Plan" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Should" name="_should_create_import_list_job">
      <bpmn:incoming>Flow_S_Plan_T_Should</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Should_G_Should</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Should" name="Utworzyć?" default="Flow_G_Should_E_Skip">
      <bpmn:incoming>Flow_T_Should_G_Should</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Should_T_Create</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Should_E_Skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Create" name="_create_import_list_record [import_list | auth]">
      <bpmn:incoming>Flow_G_Should_T_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Create_E_Plan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Plan" name="Log listy utworzony">
      <bpmn:incoming>Flow_T_Create_E_Plan</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Skip" name="Pominięto">
      <bpmn:incoming>Flow_G_Should_E_Skip</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_List" name="Cron kolejki">
      <bpmn:outgoing>Flow_S_List_T_List</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_S_List" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_List" name="import_list: get_received_invoices">
      <bpmn:incoming>Flow_S_List_T_List</bpmn:incoming>
      <bpmn:outgoing>Flow_T_List_G_List</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_List" name="Sukces?" default="Flow_G_List_E_LFail">
      <bpmn:incoming>Flow_T_List_G_List</bpmn:incoming>
      <bpmn:outgoing>Flow_G_List_Sub</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_List_E_LFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_LFail" name="failed, ponowienie +5 min">
      <bpmn:incoming>Flow_G_List_E_LFail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub" name="Dla każdej faktury z listy">
      <bpmn:incoming>Flow_G_List_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_T_Done</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="SS" name="">
        <bpmn:outgoing>Flow_SS_G1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="G1" name="Faktura w Odoo?">
        <bpmn:incoming>Flow_SS_G1</bpmn:incoming>
        <bpmn:outgoing>Flow_G1_G2</bpmn:outgoing>
        <bpmn:outgoing>Flow_G1_SE</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G2" name="Log importu istnieje?">
        <bpmn:incoming>Flow_G1_G2</bpmn:incoming>
        <bpmn:outgoing>Flow_G2_T_Child</bpmn:outgoing>
        <bpmn:outgoing>Flow_G2_SE</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Child" name="Utwórz log potomny [draft]">
        <bpmn:incoming>Flow_G2_T_Child</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Child_SE</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SE" name="">
        <bpmn:incoming>Flow_G1_SE</bpmn:incoming>
        <bpmn:incoming>Flow_G2_SE</bpmn:incoming>
        <bpmn:incoming>Flow_T_Child_SE</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SS_G1" sourceRef="SS" targetRef="G1" />
      <bpmn:sequenceFlow id="Flow_G1_G2" name="nie" sourceRef="G1" targetRef="G2" />
      <bpmn:sequenceFlow id="Flow_G1_SE" name="tak" sourceRef="G1" targetRef="SE" />
      <bpmn:sequenceFlow id="Flow_G2_T_Child" name="nie" sourceRef="G2" targetRef="T_Child" />
      <bpmn:sequenceFlow id="Flow_G2_SE" name="tak" sourceRef="G2" targetRef="SE" />
      <bpmn:sequenceFlow id="Flow_T_Child_SE" sourceRef="T_Child" targetRef="SE" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="T_Done" name="ksef_operation = completed">
      <bpmn:incoming>Flow_Sub_T_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Done_E_List</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_List" name="Koniec">
      <bpmn:incoming>Flow_T_Done_E_List</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_Ch" name="Cron kolejki">
      <bpmn:outgoing>Flow_S_Ch_T_Imp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_S_Ch" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Imp" name="import_invoice: pobranie XML [queued]">
      <bpmn:incoming>Flow_S_Ch_T_Imp</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Imp_T_Res</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Res" name="restore_invoice: account.move [received]">
      <bpmn:incoming>Flow_T_Imp_T_Res</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Res_E_Ch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Ch" name="completed">
      <bpmn:incoming>Flow_T_Res_E_Ch</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_Plan_T_Should" sourceRef="S_Plan" targetRef="T_Should" />
    <bpmn:sequenceFlow id="Flow_T_Should_G_Should" sourceRef="T_Should" targetRef="G_Should" />
    <bpmn:sequenceFlow id="Flow_G_Should_T_Create" name="tak" sourceRef="G_Should" targetRef="T_Create" />
    <bpmn:sequenceFlow id="Flow_G_Should_E_Skip" name="nie" sourceRef="G_Should" targetRef="E_Skip" />
    <bpmn:sequenceFlow id="Flow_T_Create_E_Plan" sourceRef="T_Create" targetRef="E_Plan" />
    <bpmn:sequenceFlow id="Flow_S_List_T_List" sourceRef="S_List" targetRef="T_List" />
    <bpmn:sequenceFlow id="Flow_T_List_G_List" sourceRef="T_List" targetRef="G_List" />
    <bpmn:sequenceFlow id="Flow_G_List_Sub" name="tak" sourceRef="G_List" targetRef="Sub" />
    <bpmn:sequenceFlow id="Flow_G_List_E_LFail" name="nie" sourceRef="G_List" targetRef="E_LFail" />
    <bpmn:sequenceFlow id="Flow_Sub_T_Done" sourceRef="Sub" targetRef="T_Done" />
    <bpmn:sequenceFlow id="Flow_T_Done_E_List" sourceRef="T_Done" targetRef="E_List" />
    <bpmn:sequenceFlow id="Flow_S_Ch_T_Imp" sourceRef="S_Ch" targetRef="T_Imp" />
    <bpmn:sequenceFlow id="Flow_T_Imp_T_Res" sourceRef="T_Imp" targetRef="T_Res" />
    <bpmn:sequenceFlow id="Flow_T_Res_E_Ch" sourceRef="T_Res" targetRef="E_Ch" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Kontrola duplikatów: numer KSeF wśród logów importu (bez warunku parent_id, wersja 15.1.6).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" sourceRef="G2" targetRef="N2" />
  </bpmn:process>
