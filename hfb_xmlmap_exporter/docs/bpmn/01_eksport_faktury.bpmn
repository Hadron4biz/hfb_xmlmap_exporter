<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_01" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_01" name="Eksport faktury do KSeF">
    <bpmn:participant id="Part_KSeF" name="API KSeF 2.0 (MF)">
    </bpmn:participant>
    <bpmn:participant id="Part_Odoo" name="Odoo 15 – hfb_xmlmap_exporter" processRef="Process_Eksport">
    </bpmn:participant>
    <bpmn:messageFlow id="M_Send" name="Faktura" sourceRef="T_Send" targetRef="Part_KSeF" />
    <bpmn:messageFlow id="M_Upo" name="UPO" sourceRef="Part_KSeF" targetRef="T_Upo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Eksport" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Eksport">
      <bpmn:lane id="Lane_U" name="Użytkownik (account.move)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Exp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="System – ir.cron 41 (backend python)">
        <bpmn:flowNodeRef>Tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Upo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Fail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Faktura zatwierdzona">
      <bpmn:outgoing>Flow_Start_T_Val</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Val" name="Weryfikacja XSD (action_validate_template)">
      <bpmn:incoming>Flow_Start_T_Val</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Val_G_Val</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Val" name="XSD poprawny?" default="Flow_G_Val_E_Inv">
      <bpmn:incoming>Flow_T_Val_G_Val</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Val_T_Exp</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Val_E_Inv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Inv" name="Błędy walidacji [invalid]">
      <bpmn:incoming>Flow_G_Val_E_Inv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Exp" name="Zatwierdź wysłanie (action_export_xml) [queued]">
      <bpmn:incoming>Flow_G_Val_T_Exp</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Exp_Tm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Tm" name="Cron kolejki (co 1 min)">
      <bpmn:incoming>Flow_T_Exp_Tm</bpmn:incoming>
      <bpmn:outgoing>Flow_Tm_T_Auth</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Tm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_Auth" name="auth">
      <bpmn:incoming>Flow_Tm_T_Auth</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Auth_T_Open</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Open" name="open_session">
      <bpmn:incoming>Flow_T_Auth_T_Open</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Open_T_Send</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Send" name="send_invoice [sent]">
      <bpmn:incoming>Flow_T_Open_T_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Send_T_Chk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Chk" name="check_status">
      <bpmn:incoming>Flow_T_Send_T_Chk</bpmn:incoming>
      <bpmn:incoming>Flow_G_Chk_T_Chk</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Chk_G_Chk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Chk" name="Kod statusu?" default="Flow_G_Chk_T_Chk">
      <bpmn:incoming>Flow_T_Chk_G_Chk</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Chk_T_Upo</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Chk_E_Fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Chk_T_Chk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Upo" name="download_upo [received]">
      <bpmn:incoming>Flow_G_Chk_T_Upo</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Upo_T_Close</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Close" name="close_session">
      <bpmn:incoming>Flow_T_Upo_T_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Close_E_Ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Ok" name="completed">
      <bpmn:incoming>Flow_T_Close_E_Ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Fail" name="failed (130, 140, 330, 440–446)">
      <bpmn:incoming>Flow_G_Chk_E_Fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_T_Val" sourceRef="Start" targetRef="T_Val" />
    <bpmn:sequenceFlow id="Flow_T_Val_G_Val" sourceRef="T_Val" targetRef="G_Val" />
    <bpmn:sequenceFlow id="Flow_G_Val_T_Exp" name="tak" sourceRef="G_Val" targetRef="T_Exp" />
    <bpmn:sequenceFlow id="Flow_G_Val_E_Inv" name="nie" sourceRef="G_Val" targetRef="E_Inv" />
    <bpmn:sequenceFlow id="Flow_T_Exp_Tm" sourceRef="T_Exp" targetRef="Tm" />
    <bpmn:sequenceFlow id="Flow_Tm_T_Auth" sourceRef="Tm" targetRef="T_Auth" />
    <bpmn:sequenceFlow id="Flow_T_Auth_T_Open" sourceRef="T_Auth" targetRef="T_Open" />
    <bpmn:sequenceFlow id="Flow_T_Open_T_Send" sourceRef="T_Open" targetRef="T_Send" />
    <bpmn:sequenceFlow id="Flow_T_Send_T_Chk" sourceRef="T_Send" targetRef="T_Chk" />
    <bpmn:sequenceFlow id="Flow_T_Chk_G_Chk" sourceRef="T_Chk" targetRef="G_Chk" />
    <bpmn:sequenceFlow id="Flow_G_Chk_T_Upo" name="200 + URL UPO" sourceRef="G_Chk" targetRef="T_Upo" />
    <bpmn:sequenceFlow id="Flow_G_Chk_E_Fail" name="błąd krytyczny" sourceRef="G_Chk" targetRef="E_Fail" />
    <bpmn:sequenceFlow id="Flow_G_Chk_T_Chk" name="inny kod" sourceRef="G_Chk" targetRef="T_Chk" />
    <bpmn:sequenceFlow id="Flow_T_Upo_T_Close" sourceRef="T_Upo" targetRef="T_Close" />
    <bpmn:sequenceFlow id="Flow_T_Close_E_Ok" sourceRef="T_Close" targetRef="E_Ok" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Błąd kroku: ksef_status=failed, ksef_retry_count+1, ponowienie po 5 min; ksef_max_retries nie jest sprawdzane (ścieżka python).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" sourceRef="T_Auth" targetRef="N1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_01">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_01" bpmnElement="Collab_01">
      <bpmndi:BPMNShape id="Part_KSeF_di" bpmnElement="Part_KSeF" isHorizontal="true">
        <dc:Bounds x="160" y="20" width="1720" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Odoo_di" bpmnElement="Part_Odoo" isHorizontal="true">
        <dc:Bounds x="160" y="110" width="1720" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_U_di" bpmnElement="Lane_U" isHorizontal="true">
        <dc:Bounds x="190" y="110" width="1690" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_S_di" bpmnElement="Lane_S" isHorizontal="true">
