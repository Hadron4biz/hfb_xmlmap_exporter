<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_03" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_03" name="Cron kolejki KSeF">
    <bpmn:participant id="Part_Odoo" name="ir.cron 41 – _cron_process_ksef_queue (co 1 min)" processRef="Process_Kolejka">
    </bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="Process_Kolejka" isExecutable="false">
    <bpmn:startEvent id="S" name="Co 1 min">
      <bpmn:outgoing>Flow_S_T_Search</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_S" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Search" name="search ready_domain (create_date, limit 20)">
      <bpmn:incoming>Flow_S_T_Search</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Search_Sub</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Sub" name="Dla każdego kandydata (przerwij po 5)">
      <bpmn:incoming>Flow_T_Search_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_E</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="SS" name="">
        <bpmn:outgoing>Flow_SS_T_Lock</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_Lock" name="_acquire_db_lock (FOR UPDATE NOWAIT)">
        <bpmn:incoming>Flow_SS_T_Lock</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Lock_G_Lock</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Lock" name="Zablokowano?" default="Flow_G_Lock_SE">
        <bpmn:incoming>Flow_T_Lock_G_Lock</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Lock_G_Be</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Lock_SE</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="G_Be" name="api_backend">
        <bpmn:incoming>Flow_G_Lock_G_Be</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Be_T_Py</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Be_T_Java</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Py" name="_process_python_flow">
        <bpmn:incoming>Flow_G_Be_T_Py</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Py_G_Ok</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Java" name="_process_java_flow">
        <bpmn:incoming>Flow_G_Be_T_Java</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Java_SE</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_Ok" name="Sukces?" default="Flow_G_Ok_T_Err">
        <bpmn:incoming>Flow_T_Py_G_Ok</bpmn:incoming>
        <bpmn:outgoing>Flow_G_Ok_T_Next</bpmn:outgoing>
        <bpmn:outgoing>Flow_G_Ok_T_Err</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Next" name="ksef_operation = następna">
        <bpmn:incoming>Flow_G_Ok_T_Next</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Next_SE</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_Err" name="failed, retry+1, +5 min">
        <bpmn:incoming>Flow_G_Ok_T_Err</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Err_SE</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SE" name="">
        <bpmn:incoming>Flow_G_Lock_SE</bpmn:incoming>
        <bpmn:incoming>Flow_T_Next_SE</bpmn:incoming>
        <bpmn:incoming>Flow_T_Err_SE</bpmn:incoming>
        <bpmn:incoming>Flow_T_Java_SE</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SS_T_Lock" sourceRef="SS" targetRef="T_Lock" />
      <bpmn:sequenceFlow id="Flow_T_Lock_G_Lock" sourceRef="T_Lock" targetRef="G_Lock" />
      <bpmn:sequenceFlow id="Flow_G_Lock_G_Be" name="tak" sourceRef="G_Lock" targetRef="G_Be" />
      <bpmn:sequenceFlow id="Flow_G_Lock_SE" name="nie" sourceRef="G_Lock" targetRef="SE" />
      <bpmn:sequenceFlow id="Flow_G_Be_T_Py" name="python" sourceRef="G_Be" targetRef="T_Py" />
      <bpmn:sequenceFlow id="Flow_G_Be_T_Java" name="java" sourceRef="G_Be" targetRef="T_Java" />
      <bpmn:sequenceFlow id="Flow_T_Py_G_Ok" sourceRef="T_Py" targetRef="G_Ok" />
      <bpmn:sequenceFlow id="Flow_G_Ok_T_Next" name="tak" sourceRef="G_Ok" targetRef="T_Next" />
      <bpmn:sequenceFlow id="Flow_G_Ok_T_Err" name="nie" sourceRef="G_Ok" targetRef="T_Err" />
      <bpmn:sequenceFlow id="Flow_T_Next_SE" sourceRef="T_Next" targetRef="SE" />
      <bpmn:sequenceFlow id="Flow_T_Err_SE" sourceRef="T_Err" targetRef="SE" />
      <bpmn:sequenceFlow id="Flow_T_Java_SE" sourceRef="T_Java" targetRef="SE" />
    </bpmn:subProcess>
    <bpmn:endEvent id="E" name="Koniec przebiegu">
      <bpmn:incoming>Flow_Sub_E</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T_Search" sourceRef="S" targetRef="T_Search" />
    <bpmn:sequenceFlow id="Flow_T_Search_Sub" sourceRef="T_Search" targetRef="Sub" />
    <bpmn:sequenceFlow id="Flow_Sub_E" sourceRef="Sub" targetRef="E" />
    <bpmn:textAnnotation id="N3"><bpmn:text>Każdy zwrócony słownik (także success=False) liczy się do limitu 5 (l. 874).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" sourceRef="Sub" targetRef="N3" />
  </bpmn:process>
